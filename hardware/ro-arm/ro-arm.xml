<!--
  Waveshare RoArm-M2-S (claw end effector) for MuJoCo.
  Converted from the URDF in waveshareteam/roarm_ws_em0 (roarm_description).
  Base is fixed to the world. 4 position-controlled joints: base, shoulder, elbow, gripper.
-->
<mujoco model="roarm_m2">
  <compiler angle="radian" meshdir="meshes"/>
  <option timestep="0.002" gravity="0 0 -9.81"/>

  <default>
    <joint damping="1" armature="0.001"/>
    <!-- arm geoms touch the floor but not each other -->
    <geom type="mesh" contype="1" conaffinity="0" rgba="0.75 0.75 0.75 1"/>
    <position kp="60" forcerange="-3 3"/>
  </default>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3"/>
    <global azimuth="135" elevation="-25"/>
  </visual>

  <asset>
    <mesh name="base_link" file="base_link.STL"/>
    <mesh name="link1" file="link1.STL"/>
    <mesh name="link2" file="link2.STL"/>
    <mesh name="link3" file="link3.STL"/>
    <mesh name="gripper_link" file="gripper_link.STL"/>
    <texture name="grid" type="2d" builtin="checker" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" width="512" height="512"/>
    <material name="grid" texture="grid" texrepeat="8 8" reflectance="0.1"/>
    <texture type="skybox" builtin="gradient" rgb1="0.4 0.5 0.6" rgb2="0 0 0" width="512" height="512"/>
  </asset>

  <worldbody>
    <light pos="0.5 0.5 1.5" dir="-0.3 -0.3 -1" directional="true"/>
    <geom name="floor" type="plane" size="1 1 0.05" material="grid" contype="0" conaffinity="1"/>

    <body name="base_link">
      <geom mesh="base_link"/>
      <body name="link1" pos="0.01 0 0.123059">
        <inertial pos="0 9.7024e-06 -0.0146667" quat="0.707433 0.70678 0 0" mass="0.0928888" diaginertia="6.09211e-05 4.88051e-05 2.53493e-05"/>
        <joint name="base" range="-3.1416 3.1416" axis="0 0 -1"/>
        <geom mesh="link1"/>
        <body name="link2" quat="0.5 -0.5 -0.5 -0.5">
          <inertial pos="0.122021 6.61338e-05 -9.50311e-05" quat="0.498128 0.497925 0.50206 0.501871" mass="0.0895817" diaginertia="0.00035039 0.000333057 2.62492e-05"/>
          <joint name="shoulder" range="-1.5708 1.5708" axis="0 0 -1"/>
          <geom mesh="link2"/>
          <body name="link3" pos="0.236815 0.0300024 0" quat="0.707107 0 0 0.707107">
            <inertial pos="-0.000762809 -0.11442 -0.000177275" quat="0.672045 0.673543 -0.217394 0.217796" mass="0.123009" diaginertia="0.000104224 0.000103898 1.46353e-05"/>
            <joint name="elbow" range="-1 3.1416" axis="0 0 1"/>
            <geom mesh="link3"/>
            <body name="gripper_link" pos="0.002906 -0.21599 -0.00066683" quat="0.499998 -0.5 0.500002 -0.5">
              <inertial pos="0.0288857 -0.000776842 -0.000779765" quat="0.526622 0.526622 0.471878 0.471879" mass="0.00365698" diaginertia="2.34478e-06 1.4718e-06 1.13696e-06"/>
              <joint name="gripper" range="0 1.5" axis="0 0 1"/>
              <geom mesh="gripper_link" rgba="0.22 0.22 0.22 1"/>
            </body>
            <site name="tcp" pos="0.002 -0.2802 0" size="0.005" rgba="1 0 0 1"/>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <position name="base" joint="base" ctrlrange="-3.1416 3.1416"/>
    <position name="shoulder" joint="shoulder" ctrlrange="-1.5708 1.5708"/>
    <position name="elbow" joint="elbow" ctrlrange="-1 3.1416"/>
    <position name="gripper" joint="gripper" ctrlrange="0 1.5" kp="2"/>
  </actuator>

  <keyframe>
    <key name="home" qpos="0 0 1.5708 0" ctrl="0 0 1.5708 0"/>
  </keyframe>
</mujoco>
